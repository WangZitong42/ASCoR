{
  "name": "isprs_vi2pr",
  "family": "isprs",
  "checkpoint_experiment": "isprs_vi2pr",
  "seed": null,
  "selection_rule": "fixed_final_epoch",
  "resize": 512,
  "data": {
    "train_images": "isprs_dg/vaihingen_irrg_cross_344/img_dir/train",
    "train_labels": "isprs_dg/vaihingen_irrg_cross_344/ann_dir/train",
    "target_images": "isprs_dg/potsdam_rgb/img_dir/val",
    "target_labels": "isprs_dg/potsdam_rgb/ann_dir/val"
  },
  "fusion": {
    "epochs": 3,
    "lr": 0.0002,
    "weight_decay": 0.0001,
    "grad_clip": 1.0,
    "hidden_dim": 32,
    "router_scale": 0.5,
    "negative_cost": 1.5,
    "max_b_weight": 0.2,
    "lambda_xded": 0.5,
    "xded_temperature": 4.0,
    "xded_warmup_epochs": 1,
    "lambda_cons": 0.1,
    "router_aug_prob": 0.5,
    "router_aug_strength": 0.5,
    "eval_interval": 3,
    "save_interval": 1
  },
  "fusion_module": "method.fusion_isprs",
  "tcsb": {
    "probe_epochs": 1,
    "probe_r": 128,
    "epochs": 5,
    "lr": 5e-05,
    "weight_decay": 0,
    "lora_dropout": 0.05,
    "alpha_multiplier": 2.0,
    "candidate_blocks": "3,7,11,15,19,23,27,31",
    "total_rank_budget": 512,
    "rank_min": 4,
    "rank_max": 256,
    "score_mode": "fro_sq",
    "rank_conversion": "svd",
    "global_scale_min": 0.8,
    "eval_global_scale": 0.8,
    "eval_interval": 1,
    "class_weights": "1,1,1,1,1,1"
  },
  "tsdb": {
    "epochs": 15,
    "lr": 0.0001,
    "weight_decay": 0.05,
    "grad_clip": 1.0,
    "embed_dim": 256,
    "num_queries": 100,
    "decoder_layers": 6,
    "num_heads": 8,
    "gse_base_channels": 64,
    "query_mode": "add",
    "no_object_weight": 0.1,
    "earth_dim": 24,
    "earth_adapter_start": 0,
    "earth_fft_start": 24,
    "earth_cutoff_ratio": 0.3,
    "earth_scale": 0.1,
    "appearance_seg_weight": 0.7,
    "appearance_start_epoch": 1,
    "appearance_strength": 0.75,
    "lambda_rescue": 0.5,
    "rescue_gamma": 2.0,
    "max_rescue_weight": 0.8,
    "rescue_ramp_epochs": 2,
    "structure_scale": 0.05,
    "eval_interval": 5,
    "save_interval": 1,
    "class_weights": "0.8,1.0,1.1,1.1,1.5,1.5"
  }
}
